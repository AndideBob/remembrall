# Remembrall — environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Comma-free single value. Used by services for logging verbosity.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Vector DB (Chroma)
# ---------------------------------------------------------------------------
CHROMA_HOST=vector-db
CHROMA_PORT=8000

# ---------------------------------------------------------------------------
# Embeddings (local sentence-transformers by default — no API key needed)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# LLM gateway
#   Default provider decided in Phase 4. Anthropic-via-subscription is the
#   intended default; API key and Ollama are fallbacks. Leave keys blank
#   until the provider path is finalized.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic
# Only needed if LLM_PROVIDER=anthropic uses the API-key path (not subscription):
ANTHROPIC_API_KEY=
# Only needed if LLM_PROVIDER=ollama:
OLLAMA_HOST=http://ollama:11434

# ---------------------------------------------------------------------------
# API service — single-user auth (shipped by default)
# ---------------------------------------------------------------------------
# Set a username and a password on first run; the API hashes the password.
APP_USERNAME=admin
APP_PASSWORD=change-me
# Secret used to sign session tokens. Generate a long random value.
SESSION_SECRET=change-me-to-a-long-random-string
